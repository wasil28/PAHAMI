# Salin ke .env.local lalu isi. File .env* tidak boleh di-commit.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai di server (Route Handler / Server Action). Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (https://openrouter.ai/keys) — semua panggilan AI lewat sini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model chat/generasi. "pro" dipakai untuk penyusunan topik; kosong = sama dengan AI_MODEL.
AI_MODEL=google/gemini-2.5-flash
AI_MODEL_PRO=
# Model embedding — dimensi HARUS sama dengan kolom vector di database (768).
AI_EMBED_MODEL=openai/text-embedding-3-small
# Model gambar sampul topik (termurah; dekoratif). Kosong = google/gemini-3.1-flash-lite-image.
AI_MODEL_GAMBAR=
AI_EMBED_DIM=768

# Kurs untuk estimasi biaya (Rp per 1 USD) — BR-27
KURS_USD_IDR=16500

# URL aplikasi (untuk tautan email reset sandi). WAJIB di produksi: tanpa ini email reset tidak dikirim
# (fallback ke origin permintaan hanya saat development, karena header Host bisa dipalsukan).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kunci HMAC untuk cookie penanda pemulihan sandi (pahami_pemulihan). Hanya server; isi string acak
# ≥ 32 byte, mis. `openssl rand -base64 32`. Bila kosong, kunci diturunkan dari SUPABASE_SERVICE_ROLE_KEY
# (cadangan) — mengganti salah satunya membatalkan tautan reset yang sedang berjalan.
PEMULIHAN_SECRET=
